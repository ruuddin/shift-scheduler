# Dependencies & build output (restored via npm ci / named volumes in compose)
node_modules
.next
out
build
dist

# Env & secrets — NEVER bake into the image
.env*
!.env.example

# Git & VCS metadata
.git
.gitignore

# Dev machine leftovers
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.tsbuildinfo
coverage

# Tooling state that should not ship in the image
.vercel
.vscode
.idea
